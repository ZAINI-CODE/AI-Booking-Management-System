{
  "version": 2,
  "outputDirectory": "build",
  "buildCommand": "yarn build",
  "installCommand": "yarn install --network-timeout 1000000",
  "functions": {
    "api/extract-booking.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
